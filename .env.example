# Paste into Dokploy > your compose service > Environment.
# All four domains need a DNS A record pointing at the Dokploy server.
CMS_DOMAIN=hotel.example.com
GAME_DOMAIN=game.hotel.example.com
ASSETS_DOMAIN=assets.hotel.example.com
WS_DOMAIN=ws.hotel.example.com

# openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# echo "base64:$(openssl rand -base64 32)"
APP_KEY=

HOTEL_NAME=Habbo
APP_LOCALE=en
CMS_THEME=dusk

# X-Real-Ip without a proxy; CF-Connecting-IP when Cloudflare proxy (orange cloud) is on
WS_IP_HEADER=X-Real-Ip
